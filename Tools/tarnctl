#!/bin/zsh
set -u

STATUS_FILE="$HOME/Library/Application Support/Tarn/status.json"

usage() {
    cat <<'USAGE'
usage: tarnctl <command>

  start [minutes]     start a work round (default length, or any length from 1 to 180)
  pause | resume      pause or resume the timer
  toggle              start or pause
  stop                reset the current round
  skip                skip to the next phase
  break               start a break now
  breathe [full]      open Breathe mode (add "full" for full screen)
  sound on|off|toggle       ambient sound
  sound <preset>            ocean, forest, dawn, quiet
  window              open Tarn in a normal window
  settings            open the Settings window
  calm                full screen, hide apps and sound in one go
  clear | restore     hide other windows (never quits apps) and bring them back
  status [--json]     show what Tarn is doing
USAGE
}

send() { open -g "tarn://$1"; }

cmd="${1:-status}"
case "$cmd" in
    start|work)
        if [[ -n "${2:-}" ]]; then
            [[ "$2" =~ ^[0-9]+$ ]] && (( $2 >= 1 && $2 <= 180 )) || { echo "minutes must be a number from 1 to 180" >&2; exit 2; }
            send "start?minutes=$2"
        else send "start"; fi ;;
    pause|resume|toggle|stop|skip|break|clear|restore|window|settings|calm) send "$cmd" ;;
    breathe)
        if [[ "${2:-}" == "full" ]]; then send "breathe?fullscreen=1"; else send "breathe"; fi ;;
    sound)
        arg="${2:-toggle}"
        case "$arg" in
            on|off|toggle) send "sound?state=$arg" ;;
            ocean|forest|dawn|quiet) send "sound?preset=$arg&state=on" ;;
            *) echo "unknown sound '$arg' (use on, off, toggle, ocean, forest, dawn or quiet)" >&2; exit 2 ;;
        esac ;;
    status)
        if ! pgrep -x Tarn >/dev/null; then echo "Tarn is not running."; exit 1; fi
        if [[ ! -f "$STATUS_FILE" ]]; then echo "Tarn is open and idle."; exit 0; fi
        if [[ "${2:-}" == "--json" ]]; then cat "$STATUS_FILE"; echo; exit 0; fi
        mode=$(plutil -extract mode raw "$STATUS_FILE")
        phase=$(plutil -extract phase raw "$STATUS_FILE")
        running=$(plutil -extract running raw "$STATUS_FILE")
        secs=$(plutil -extract remainingSeconds raw "$STATUS_FILE")
        done_today=$(plutil -extract completedToday raw "$STATUS_FILE")
        printf '%s, %s, %02d:%02d left, %s, %s rounds today\n' "$mode" "$phase" $((secs/60)) $((secs%60)) \
            "$([[ $running == true ]] && echo running || echo paused)" "$done_today" ;;
    -h|--help|help) usage ;;
    *) usage; exit 2 ;;
esac
